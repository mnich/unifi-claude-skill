# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit real values.

# UniFi controller hostname or IP. Defaults to `unifi.local` if unset.
UDM_HOST=unifi.local

# Site name as it appears in the controller URL (/network/<site>/...). Default: default
# UDM_SITE=default

# HTTP timeout in seconds. Default: 30
# UDM_TIMEOUT=30

# API key (README.md → "Generate a UniFi API key").
# If unset, udm.py falls back to: pass $UNIFI_PASS_PATH
# UNIFI_API_KEY=your-api-key-here
# UNIFI_PASS_PATH=internal/unifi/api-key

# ── scripts/monitor.py (alerts) ─────────────────────────────────────────────
# Preferred: log in as a local admin with the View Only role (API keys always carry
# the full rights of the admin who created them, and View Only admins cannot create one).
# UNIFI_USERNAME=monitor
# UNIFI_PASSWORD=
# Push via ntfy (app on the phone, subscribe to the same topic). Use a long random
# topic name — on the public ntfy.sh server the name is the only protection.
# NTFY_URL=https://ntfy.sh/replace-with-a-long-random-topic
# NTFY_TOKEN=
# Email via a local MTA that already has the credentials (preferred), e.g. msmtp:
# SENDMAIL_CMD=msmtp -t
# …or directly via SMTP (STARTTLS)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# MAIL_TO=
# MONITOR_TEMP_MIN=5
# MONITOR_TEMP_MAX=75
# MONITOR_ADMIN_IPS=192.168.1.10,192.168.1.11
# MONITOR_IGNORE_DEVICES=
# MONITOR_STATE=~/.local/state/udm-monitor.json
